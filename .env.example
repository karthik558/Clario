# Clario Environment Configuration

# Project Details
PROJECT_NAME="Clario"
TAGLINE="Every document. A clearer answer."

# Database & Storage
DATABASE_URL="sqlite:///./data/clario.db"

# Information Retrieval Tuning Defaults
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
DEFAULT_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# AI / LLM Configuration
# Options: "extractive" (default local zero-cost), "gemini", "openai"
LLM_PROVIDER="extractive"

# Optional External API Keys (Leave empty for 100% offline local extractive mode)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_MODEL="gpt-4o-mini"
